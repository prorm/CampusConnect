  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Clear mint action with a quiet lift on hover.",
      "html": "<button class=\"ds-button-primary\">Find my next opportunity<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:15px;padding:15px 23px;border-radius:8px;font-family:'DM Sans Variable',sans-serif;font-size:14px;font-weight:600;line-height:1.4;border:0;cursor:pointer;transition:background .2s,transform .2s,box-shadow .2s;background:var(--mint,#b8f4d6);color:#102820}.ds-button-primary:hover:not(:disabled){background:#d3ffe8;transform:translateY(-2px);box-shadow:0 8px 22px #9ee8c018}.ds-button-primary:disabled{opacity:.48;cursor:not-allowed}.ds-button-primary:focus-visible{outline:2px solid var(--mint,#b8f4d6);outline-offset:5px;border-radius:4px;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}.ds-button-primary:hover{transform:none}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Translucent outlined alternative to the mint action.",
      "html": "<button class=\"ds-button-secondary\">View my schedule<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:15px;padding:15px 23px;border-radius:8px;font-family:'DM Sans Variable',sans-serif;font-size:14px;font-weight:600;line-height:1.4;border:0;cursor:pointer;transition:background .2s,transform .2s,box-shadow .2s;background:#b9dcd009;border:1px solid #b9dcd026;color:#d7e9e4}.ds-button-secondary:hover:not(:disabled){background:#b9dcd017;transform:translateY(-2px);box-shadow:0 8px 22px #9ee8c018}.ds-button-secondary:disabled{opacity:.48;cursor:not-allowed}.ds-button-secondary:focus-visible{outline:2px solid var(--mint,#b8f4d6);outline-offset:5px;border-radius:4px;}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}.ds-button-secondary:hover{transform:none}}"
    },
    {
      "name": "Text Button",
      "kind": "button",
      "refersTo": "text-button",
      "description": "Quiet operational navigation with a moving arrow.",
      "html": "<button class=\"ds-text-button\">Explore this free window<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-text-button{padding:0;display:inline-flex;align-items:center;gap:10px;font-family:'DM Sans Variable',sans-serif;font-size:14px;font-weight:500;line-height:1.6;text-align:left;border:0;background:none;color:var(--text,#eaf2ef);cursor:pointer}.ds-text-button:hover{color:var(--mint,#b8f4d6)}.ds-text-button svg{transition:transform .2s}.ds-text-button:hover svg{transform:translateX(3px)}.ds-text-button:focus-visible{outline:2px solid var(--mint,#b8f4d6);outline-offset:5px;border-radius:4px;}@media(prefers-reduced-motion:reduce){.ds-text-button svg{transition:none}.ds-text-button:hover svg{transform:none}}"
    },
    {
      "name": "Form Field",
      "kind": "input",
      "refersTo": "form-field",
      "description": "Readable operational field with an explicit label and mint focus.",
      "html": "<label class=\"ds-field-label\">Your interests<input class=\"ds-field\" placeholder=\"Design, technology, leadership\" /></label>",
      "css": ".ds-field-label{display:flex;flex-direction:column;gap:8px;color:#c6d9ca;font-family:'DM Sans Variable',sans-serif;font-size:14px}.ds-field{padding:11px 13px;border:1px solid #b8f4d626;border-radius:7px;background:#0f1c1d7a;color:#e2eee6;font-family:'DM Sans Variable',sans-serif;font-size:14px;line-height:1.5;caret-color:var(--mint,#b8f4d6)}.ds-field::placeholder{color:#91a7a6}.ds-field:focus-visible{outline:2px solid var(--mint,#b8f4d6);outline-offset:5px;border-radius:4px;}"
    },
    {
      "name": "Workspace Navigation",
      "kind": "nav",
      "refersTo": "workspace-navigation",
      "description": "A readable selected destination with current-page semantics.",
      "html": "<nav aria-label=\"Workspace navigation\" class=\"ds-nav\"><button class=\"ds-nav-link ds-nav-active\" aria-current=\"page\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM12 2v2m0 16v2M2 12h2m16 0h2\"/></svg>My campus today<span class=\"ds-nav-dot\"></span></button><button class=\"ds-nav-link\">Discover</button></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:6px}.ds-nav-link{display:flex;align-items:center;gap:12px;min-height:43px;padding:11px 12px;border-radius:8px;font-family:'DM Sans Variable',sans-serif;font-size:14px;color:#9fb7ad;text-align:left;border:0;background:none;cursor:pointer}.ds-nav-link:hover{background:#b8f4d609;color:#d8eee4}.ds-nav-link.ds-nav-active{background:#b8f4d610;color:var(--mint,#b8f4d6)}.ds-nav-dot{width:4px;height:4px;background:var(--mint,#b8f4d6);border-radius:50%;margin-left:auto}.ds-nav-link:focus-visible{outline:2px solid var(--mint,#b8f4d6);outline-offset:5px;border-radius:4px;}"
    },
    {
      "name": "Metadata Pill",
      "kind": "chip",
      "refersTo": "pill",
      "description": "A softly outlined metadata capsule at the shared compact size.",
      "html": "<span class=\"ds-pill\">Fits your timetable</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:7px;font-family:'DM Sans Variable',sans-serif;font-size:11px;padding:6px 11px;border:1px solid var(--line,rgba(187,215,213,.13));border-radius:100px;line-height:1.5;color:var(--text,#eaf2ef)}"
    },
    {
      "name": "Category Filters",
      "kind": "chip",
      "description": "Mint selection among quiet outlined operational filters.",
      "html": "<div class=\"ds-filters\"><button class=\"ds-filter ds-filter-active\" aria-pressed=\"true\">All opportunities</button><button class=\"ds-filter\" aria-pressed=\"false\">Technology</button></div>",
      "css": ".ds-filters{display:flex;gap:8px;flex-wrap:wrap}.ds-filter{padding:8px 17px;font-family:'DM Sans Variable',sans-serif;font-size:14px;border:1px solid var(--line,rgba(187,215,213,.13));border-radius:50px;color:#aac2b4;background:none;cursor:pointer}.ds-filter.ds-filter-active{background:var(--mint,#b8f4d6);color:#163125;border-color:var(--mint,#b8f4d6)}.ds-filter:hover:not(.ds-filter-active){background:#b8f4d60c}.ds-filter:focus-visible{outline:2px solid var(--mint,#b8f4d6);outline-offset:5px;border-radius:4px;}"
    },
    {
      "name": "Glass Opportunity Card",
      "kind": "card",
      "refersTo": "glass-card",
      "description": "A contained opportunity with a readable title and useful action.",
      "html": "<article class=\"ds-card\"><span class=\"ds-card-host\">CODECRAFT · TODAY</span><h3 class=\"ds-card-title\"><button class=\"ds-card-title-button\">Build your first AI agent</button></h3><p class=\"ds-card-meta\">12:45 PM · Innovation Lab</p><div class=\"ds-card-bottom\"><span>Fits your timetable</span><button class=\"ds-card-action\">View event<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button></div></article>",
      "css": ".ds-card{padding:20px;background:linear-gradient(135deg,rgba(32,52,59,.66),rgba(16,29,36,.72));border:1px solid var(--line,rgba(187,215,213,.13));backdrop-filter:blur(22px);border-radius:var(--radius,16px);color:var(--text,#eaf2ef);font-family:'DM Sans Variable',sans-serif;transition:background .25s;max-width:330px}.ds-card:hover{background:#24413c73}.ds-card-host{font-size:12px;color:#8da99a}.ds-card-title{font-family:var(--display,'Space Grotesk Variable',sans-serif);font-size:21px;font-weight:500;line-height:1.3;letter-spacing:-.035em;margin:10px 0 12px}.ds-card-title-button{padding:0;text-align:left;font:inherit;letter-spacing:inherit;border:0;background:none;color:inherit;cursor:pointer}.ds-card-title-button:hover{color:var(--mint,#b8f4d6)}.ds-card-meta{font-size:12px;color:#a4bcb0;line-height:1.7;margin:0}.ds-card-bottom{border-top:1px solid var(--line,rgba(187,215,213,.13));margin-top:18px;padding-top:15px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;font-size:12px}.ds-card-action{display:inline-flex;align-items:center;justify-content:center;gap:15px;padding:15px 23px;border-radius:8px;font-family:'DM Sans Variable',sans-serif;font-size:14px;font-weight:600;line-height:1.4;border:0;cursor:pointer;transition:background .2s,transform .2s,box-shadow .2s;font-size:14px;padding:8px 10px;gap:5px;background:var(--mint,#b8f4d6);color:#102820}.ds-card-action:hover{background:#d3ffe8;transform:translateY(-2px);box-shadow:0 8px 22px #9ee8c018}.ds-card-title-button:focus-visible{outline:2px solid var(--mint,#b8f4d6);outline-offset:5px;border-radius:4px;}.ds-card-action:focus-visible{outline:2px solid var(--mint,#b8f4d6);outline-offset:5px;border-radius:4px;}@media(prefers-reduced-motion:reduce){.ds-card,.ds-card-action{transition:none}.ds-card-action:hover{transform:none}}"
