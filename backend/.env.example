# ─────────────────────────────────────────────────────────────
# CampusConnect API configuration
# Copy this file to backend/.env and fill in the values below.
# ─────────────────────────────────────────────────────────────

# Port the Express API listens on.
PORT=5000

# MongoDB connection string  ← paste yours here
#   Local:  mongodb://127.0.0.1:27017/campusconnect
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusconnect?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/campusconnect

# Secret used to sign login tokens. Use a long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<a-long-random-secret>
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed to call the API (comma-separated).
CLIENT_URL=http://localhost:5173

# Groq API key  ← paste yours here (free at https://console.groq.com/keys)
# Powers the campus assistant, poster image reading, and feedback summaries.
# Leave empty to use the built-in rule-based engine; every feature still works.
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Fixed campus clock for repeatable presentations (YYYY-MM-DD and HH:MM).
DEMO_DATE=2026-10-07
DEMO_TIME=12:20

# One-click demo sign-in and automatic seeding of an empty database.
# Set both to false for a real deployment.
DEMO_ACCOUNTS=true
AUTO_SEED=true
